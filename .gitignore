# Build
dist/
# Anchored to the repo root: an unanchored `build/` also swallowed docs/build/,
# which is documentation, not a build artifact.
/build/
**/node_modules/**/build/
*.egg-info/
.next/
.vercel/
out/

# Claude Code — local config stays local, but `rules/` is project guidance that
# CLAUDE.md points at, so it has to travel with the repo. Note `.claude/*` and
# not `.claude/`: git will not descend into an excluded directory, so the
# negation below only works if the directory itself is never excluded.
.claude/*
!.claude/rules/

# Tool artifacts
.playwright-mcp/

# Local audit / scratch dirs (working notes, never deploy)
.audit/
.scratch/
tmp_*/

# GSD planning artefacts (local only)
